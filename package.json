{
  "name": "agentic-address",
  "version": "0.2.1",
  "description": "Postal address verification and normalization with Smarty, Lob, PostGrid, and OpenStreetMap adapters for Node.js, CLI, and MCP.",
  "keywords": [
    "address-verification",
    "address-validation",
    "postal-address",
    "normalization",
    "smarty",
    "smartystreets",
    "lob",
    "postgrid",
    "openstreetmap",
    "nominatim",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "csv"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-address.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-address",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "bin": {
    "agentic-address": "./dist/cli.js",
    "agentic-address-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0",
    "agentic-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
